  <div class="container">
    <header>
      <h1>✨ AI Dyslexia Adapter & Reader</h1>
      <p>Transform dense textbooks into accessible, low-stress learning material</p>
    </header>

    <!-- Accessibility Controls -->
    <div class="controls-card">
      <div class="control-group">
        <label for="fontSelect">Font:</label>
        <select id="fontSelect" onchange="changeFont(this.value)">
          <option value="'Lexend', sans-serif">Lexend (Dyslexia Friendly)</option>
          <option value="Arial, sans-serif">Arial</option>
          <option value="'Courier New', monospace">Monospace</option>
        </select>
      </div>

      <div class="control-group">
        <label for="spacingSelect">Line Spacing:</label>
        <select id="spacingSelect" onchange="changeSpacing(this.value)">
          <option value="1.8">Normal (1.8x)</option>
          <option value="2.2">Expanded (2.2x)</option>
          <option value="2.5">Extra Wide (2.5x)</option>
        </select>
      </div>

      <div class="control-group">
        <span>Overlay Tint:</span>
        <div class="tint-btn tint-white" onclick="changeTint('#ffffff')"></div>
        <div class="tint-btn tint-cream" onclick="changeTint('#fffdd0')"></div>
        <div class="tint-btn tint-blue" onclick="changeTint('#e3f2fd')"></div>
        <div class="tint-btn tint-mint" onclick="changeTint('#e8f5e9')"></div>
        <div class="tint-btn tint-peach" onclick="changeTint('#fff3e0')"></div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-grid">
      <!-- Input Card -->
      <div class="card">
        <div class="card-title">📝 Paste Dense Input Text</div>
        <textarea id="inputText" placeholder="Paste standard textbook text or lesson content here..."></textarea>
        <button class="btn-primary" onclick="transformText()">Transform for Dyslexic Reader</button>
      </div>

      <!-- Output Display Card -->
      <div class="card" id="outputCard">
        <div class="card-title">🎯 Dyslexia-Friendly Output</div>
        <div id="outputContainer">
          <p style="color: #94a3b8; font-style: italic;">Your adapted text will appear here with bullet points, syllable breakdowns, and key term highlights...</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Adjust Layout Settings dynamically
    function changeFont(font) {
      document.documentElement.style.setProperty('--font-family', font);
    }

    function changeSpacing(val) {
      document.documentElement.style.setProperty('--line-height', val);
    }

    function changeTint(color) {
      document.getElementById('outputCard').style.backgroundColor = color;
    }

    // Helper: Simple Phonetic Syllable Generator for Demo
    function syllabify(word) {
      const clean = word.replace(/[^a-zA-Z]/g, '');
      if (clean.length <= 6) return `<strong>${word}</strong>`;
      
      // Simple regex rule splitting vowels to simulate syllable breakdown
      const syllables = clean.match(/[^aeiouy]*[aeiouy]+(?:[^aeiouy]*$|[^aeiouy](?=[^aeiouy]))?/gi);
      if (!syllables) return `<strong>${word}</strong>`;
      
      return `<strong>${clean}</strong> <span class="syllable-guide">[${syllables.join('-').toLowerCase()}]</span>`;
    }

    // Processing Mechanics
    function transformText() {
      const rawText = document.getElementById('inputText').value.trim();
      const outputContainer = document.getElementById('outputContainer');

      if (!rawText) {
        outputContainer.innerHTML = '<p style="color: #ef4444;">Please paste some text first!</p>';
        return;
      }

      // Step 1: Sentence Splitting
      const sentences = rawText.match(/[^.!?]+[.!?]+/g) || [rawText];

      // Step 2: Format into micro-chunks with key terms bolded & syllable breakdowns
      let adaptedBullets = [];
      let complexWords = [];

      sentences.forEach(sentence => {
        let words = sentence.trim().split(/\s+/);
        let processedSentence = words.map(word => {
          let cleanWord = word.replace(/[^a-zA-Z]/g, '');
          // Identify longer/complex words (7+ characters)
          if (cleanWord.length >= 7) {
            complexWords.push(cleanWord);
            return syllabify(cleanWord);
          }
          return word;
        }).join(' ');

        adaptedBullets.push(`<li>${processedSentence}</li>`);
      });

      // Step 3: Generate Structured Output Component
      const summaryText = sentences.slice(0, 2).join(' ');
      const uniqueComplex = [...new Set(complexWords)].slice(0, 3);

      outputContainer.innerHTML = `
        <div class="output-section">
          <strong>📌 ORIGINAL TEXT SUMMARY</strong>
          <p style="margin-top: 4px; color: #475569;">${summaryText}</p>
        </div>

        <div class="output-section">
          <strong>✨ DYSLEXIA-FRIENDLY ADAPTATION</strong>
          <ul class="dyslexia-list" style="margin-top: 12px;">
            ${adaptedBullets.join('')}
          </ul>
        </div>

        <div class="output-section">
          <strong>💡 QUICK RECAP & CHECK</strong>
          <ul class="dyslexia-list" style="margin-top: 8px;">
            <li>Main focus words highlighted above: <strong>${uniqueComplex.join(', ') || 'None identified'}</strong>.</li>
            <li>Take a 10-second visual rest before answering questions.</li>
          </ul>
        </div>

        <div class="teacher-box">
          <strong>💡 TEACHER TIP:</strong> Provide colored overlays or allow the student to use a physical ruler to track lines visually while reading this adaptation.
        </div>
      `;
    }
  </script>
</body>
